#!/usr/bin/env bash
# RSA keypair + self-signed x509 cert for signing a FIT image (mkimage -k
# <dir>) / populating a barebox public-key keystore. Transcribed from
# barebox-arm64-poc/generate-fit's generate_keys() function, generalized so
# the output directory and key name are parameters instead of the POC's
# hardcoded ${curr_dir}/keys/dev-new (the POC also carries a keys/dev.cnf
# alongside that function, but nothing in the POC ever passes it to
# `openssl req` — dead file, not carried forward here).
#
# Usage: generate-fitkeys [out-dir] [key-name]
#   out-dir   default: ./keys
#   key-name  default: dev-new -- produces <out-dir>/<key-name>.{key,crt}
set -euo pipefail

out_dir="${1:-./keys}"
key_name="${2:-dev-new}"

mkdir -p "${out_dir}"
openssl genpkey -algorithm RSA -out "${out_dir}/${key_name}.key" \
    -pkeyopt rsa_keygen_bits:2048 -pkeyopt rsa_keygen_pubexp:65537
openssl req -batch -new -x509 -key "${out_dir}/${key_name}.key" -out "${out_dir}/${key_name}.crt"

echo "generated ${out_dir}/${key_name}.key + ${out_dir}/${key_name}.crt"
