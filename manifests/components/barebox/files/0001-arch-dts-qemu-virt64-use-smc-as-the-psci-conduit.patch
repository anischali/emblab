From cffd1687d705f66d110a45d7f3bc379027d530e8 Mon Sep 17 00:00:00 2001
From: Chali Anis <chalianis1@gmail.com>
Date: Wed, 2 Sep 2026 20:13:49 -0500
Subject: [PATCH] arch: dts: qemu-virt64: use smc as the PSCI conduit

QEMU's virt machine with virtualization=on exposes EL2 in hardware, but
nothing runs actual hypervisor software at EL2 in a coreboot -> BL31 (EL3)
-> barebox boot chain with no BL2/KVM in between. barebox's own PSCI
client issues an hvc instruction to probe PSCI version at driver-probe
time; with no EL2 exception handler installed to relay it to EL3, this
call never returns and hangs boot right after PSCI probe starts, before
any further initcalls run. TF-A's BL31 (running at EL3) answers smc
directly with no relay needed, so smc is the correct conduit whenever
normal world runs with no hypervisor underneath it, matching every other
architecture-agnostic RESET_TO_BL31 boot chain in this project.
---
 arch/arm/dts/qemu-virt64.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/dts/qemu-virt64.dts b/arch/arm/dts/qemu-virt64.dts
index 0fc98c22..77172f1d 100644
--- a/arch/arm/dts/qemu-virt64.dts
+++ b/arch/arm/dts/qemu-virt64.dts
@@ -19,7 +19,7 @@ chosen {
 
 	psci {
 		compatible = "arm,psci-1.0", "arm,psci-0.2", "arm,psci";
-		method = "hvc";
+		method = "smc";
 		migrate = <0xc4000005>;
 		cpu_on = <0xc4000003>;
 		cpu_off = <0x84000002>;
-- 
2.53.0

