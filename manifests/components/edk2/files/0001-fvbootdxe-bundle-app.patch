@@ -0,0 +1,68 @@
+## @file
+#  FvBootDxe.inf — Minimal BDS DXE driver that boots a single EFI application
+#  embedded in the platform Firmware Volume.
+#
+#  Handles full console setup (serial ConOut/ConIn/ErrOut), BootOptionSupport,
+#  and DTB config table verification before handoff.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+#  Copyright (c) 2026, Your Organisation. All rights reserved.
+##
+
+[Defines]
+  INF_VERSION    = 0x00010017
+  BASE_NAME      = FvBootDxe
+  MODULE_UNI_FILE= FvBootDxe.uni
+  FILE_GUID      = 6D5B4F83-2C1E-4A9D-B7E3-1F8C2D4A6B0E
+  MODULE_TYPE    = DXE_DRIVER
+  VERSION_STRING = 1.0
+  ENTRY_POINT    = FvBootDxeEntryPoint
+
+[Sources]
+  FvBootDxe.c
+  FvBootDxe.h
+
+[Packages]
+  MdePkg/MdePkg.dec
+  MdeModulePkg/MdeModulePkg.dec
+
+[LibraryClasses]
+  BaseLib
+  BaseMemoryLib
+  DebugLib
+  DevicePathLib
+  MemoryAllocationLib
+  PcdLib
+  PrintLib
+  UefiBootManagerLib
+  UefiBootServicesTableLib
+  UefiRuntimeServicesTableLib
+  UefiDriverEntryPoint
+  UefiLib
+
+[Protocols]
+  gEfiBdsArchProtocolGuid              ## PRODUCES
+  gEfiFirmwareVolume2ProtocolGuid      ## CONSUMES
+  gEfiSerialIoProtocolGuid             ## CONSUMES
+  gEfiDevicePathProtocolGuid           ## CONSUMES
+  gEfiDebugSupportProtocolGuid         ## CONSUMES
+  gEfiDebugPortProtocolGuid            ## CONSUMES
+  gEfiDevicePathProtocolGuid           ## CONSUMES
+  gEfiSimpleTextInProtocolGuid         ## CONSUMES
+  gEfiSimpleTextOutProtocolGuid        ## CONSUMES
+  gEfiSimpleTextInProtocolGuid         ## CONSUMES
+  gEfiGraphicsOutputProtocolGuid       ## CONSUMES
+
+[Guids]
