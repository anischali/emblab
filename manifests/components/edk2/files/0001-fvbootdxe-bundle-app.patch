diff --git a/MdeModulePkg/Universal/FvBootDxe/FvBootDxe.c b/MdeModulePkg/Universal/FvBootDxe/FvBootDxe.c
new file mode 100644
index 000000000000..a2bcad22dc8e
--- /dev/null
+++ b/MdeModulePkg/Universal/FvBootDxe/FvBootDxe.c
@@ -0,0 +1,446 @@
+/** @file
+  FvBootDxe.c — Minimal BDS replacement that loads a single EFI application
+  embedded in a Firmware Volume and transfers control to it permanently.
+
+  Before handoff:
+    - All controllers connected (block, storage, console, PCI)
+    - All consoles wired into ConSplitter via EfiBootManagerConnectAllConsoles
+    - BootOptionSupport variable set
+    - DTB configuration table verified
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+  Copyright (c) 2026, Your Organisation. All rights reserved.
+**/
+
+#include "FvBootDxe.h"
+#include <Library/UefiBootManagerLib.h>
+#include <Protocol/SimpleTextIn.h>
+
+// ── Module globals ────────────────────────────────────────────────────────────
+
+STATIC EFI_BDS_ARCH_PROTOCOL  mBds = { FvBootBdsEntry };
+
+//
+// EFI DTB Table GUID — QEMU installs the device tree here.
+//
+STATIC EFI_GUID mDtbTableGuid = {
+  0xb1b621d5, 0xf19c, 0x41a5,
+  { 0x83, 0x0b, 0xd9, 0x15, 0x2c, 0x69, 0xaa, 0xe0 }
+};
+
+// ── Internal helpers ──────────────────────────────────────────────────────────
+
+/**
+  Find the EFI application in any available Firmware Volume.
+
+  @param[out] FvHandle   Handle of the FV containing the application.
+  @retval EFI_SUCCESS    Application found.
+  @retval other          Not found or protocol error.
+**/
+STATIC
+EFI_STATUS
+FindApplicationInFv (
+  OUT EFI_HANDLE  *FvHandle
+  )
+{
+  EFI_STATUS                     Status;
+  UINTN                          HandleCount;
+  EFI_HANDLE                    *Handles;
+  UINTN                          Index;
+  EFI_FIRMWARE_VOLUME2_PROTOCOL *Fv;
+  VOID                          *Buffer;
+  UINTN                          BufferSize;
+  UINT32                         AuthStatus;
+  EFI_GUID                       AppGuid;
+
+  ASSERT (FvHandle != NULL);
+  CopyGuid (&AppGuid, (EFI_GUID *)PcdGetPtr (PcdFvBootApplicationGuid));
+
+  HandleCount = 0;
+  Handles     = NULL;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiFirmwareVolume2ProtocolGuid,
+                  NULL, &HandleCount, &Handles
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe] LocateHandleBuffer(FV2) failed: %r\n", Status));
+    return Status;
+  }
+
+  Status = EFI_NOT_FOUND;
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (
+                    Handles[Index],
+                    &gEfiFirmwareVolume2ProtocolGuid,
+                    (VOID **)&Fv
+                    );
+    if (EFI_ERROR (Status)) continue;
+
+    Buffer     = NULL;
+    BufferSize = 0;
+
+    Status = Fv->ReadSection (
+                   Fv, &AppGuid,
+                   EFI_SECTION_PE32, 0,
+                   &Buffer, &BufferSize, &AuthStatus
+                   );
+    if (!EFI_ERROR (Status)) {
+      FreePool (Buffer);
+      *FvHandle = Handles[Index];
+      FreePool (Handles);
+      return EFI_SUCCESS;
+    }
+  }
+
+  FreePool (Handles);
+  return EFI_NOT_FOUND;
+}
+
+/**
+  Build a Firmware Volume device path for the application GUID.
+
+  @param[in]  FvHandle  Handle of the Firmware Volume.
+  @return  Allocated device path or NULL.
+**/
+STATIC
+EFI_DEVICE_PATH_PROTOCOL *
+BuildFvApplicationDevicePath (
+  IN EFI_HANDLE  FvHandle
+  )
+{
+  EFI_GUID                           AppGuid;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  FileNode;
+
+  CopyGuid (&AppGuid, (EFI_GUID *)PcdGetPtr (PcdFvBootApplicationGuid));
+  EfiInitializeFwVolDevicepathNode (&FileNode, &AppGuid);
+
+  return AppendDevicePathNode (
+           DevicePathFromHandle (FvHandle),
+           (EFI_DEVICE_PATH_PROTOCOL *)&FileNode
+           );
+}
+
+// ── System table setup ────────────────────────────────────────────────────────
+
+/**
+  Connect all controller handles recursively.
+**/
+STATIC
+VOID
+ConnectAllControllers (
+  VOID
+  )
+{
+  EFI_STATUS   Status;
+  UINTN        HandleCount;
+  EFI_HANDLE  *Handles;
+  UINTN        Index;
+
+  Status = gBS->LocateHandleBuffer (
+                  AllHandles, NULL, NULL,
+                  &HandleCount, &Handles
+                  );
+  if (EFI_ERROR (Status)) return;
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+  }
+
+  FreePool (Handles);
+}
+
+/**
+  Enumerate every SimpleTextIn/Out handle, add its device path to the
+  ConIn/ConOut/ErrOut NVRAM variables, then connect all default consoles.
+
+  This replicates BdsDxe's EfiBootManagerConnectAllConsoles() fallback
+  (which is internal to UefiBootManagerLib and not in the public header).
+  No disconnect is performed, so VirtioBlk partitions and FAT remain intact.
+**/
+STATIC
+VOID
+ConnectAllConsoles (
+  VOID
+  )
+{
+  EFI_STATUS                Status;
+  UINTN                     HandleCount;
+  EFI_HANDLE               *HandleBuffer;
+  UINTN                     Index;
+  EFI_DEVICE_PATH_PROTOCOL *ConDevicePath;
+
+  HandleCount  = 0;
+  HandleBuffer = NULL;
+
+  //
+  // Add every SimpleTextInput handle's device path to the ConIn variable.
+  //
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleTextInProtocolGuid,
+                  NULL, &HandleCount, &HandleBuffer
+                  );
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < HandleCount; Index++) {
+      ConDevicePath = NULL;
+      if (!EFI_ERROR (gBS->HandleProtocol (
+                             HandleBuffer[Index],
+                             &gEfiDevicePathProtocolGuid,
+                             (VOID **)&ConDevicePath))) {
+        EfiBootManagerUpdateConsoleVariable (ConIn, ConDevicePath, NULL);
+      }
+    }
+    FreePool (HandleBuffer);
+    HandleBuffer = NULL;
+  }
+
+  //
+  // Add every SimpleTextOutput handle's device path to ConOut and ErrOut.
+  //
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleTextOutProtocolGuid,
+                  NULL, &HandleCount, &HandleBuffer
+                  );
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < HandleCount; Index++) {
+      ConDevicePath = NULL;
+      if (!EFI_ERROR (gBS->HandleProtocol (
+                             HandleBuffer[Index],
+                             &gEfiDevicePathProtocolGuid,
+                             (VOID **)&ConDevicePath))) {
+        EfiBootManagerUpdateConsoleVariable (ConOut, ConDevicePath, NULL);
+        EfiBootManagerUpdateConsoleVariable (ErrOut, ConDevicePath, NULL);
+      }
+    }
+    FreePool (HandleBuffer);
+  }
+
+  //
+  // Now trigger ConPlatformDxe to add each variable-listed device to
+  // the ConSplitter (wires gST->ConOut / gST->ConIn).
+  //
+  EfiBootManagerConnectAllDefaultConsoles ();
+
+  DEBUG ((DEBUG_ERROR,
+    "[FvBootDxe] gST->ConOut = %p  ConIn = %p\n",
+    gST->ConOut, gST->ConIn));
+}
+
+/**
+  Verify the DTB configuration table entry is present.
+**/
+STATIC
+VOID
+VerifyDtbConfigTable (
+  VOID
+  )
+{
+  UINTN    Index;
+  BOOLEAN  Found;
+
+  Found = FALSE;
+
+  for (Index = 0; Index < gST->NumberOfTableEntries; Index++) {
+    if (CompareGuid (
+          &gST->ConfigurationTable[Index].VendorGuid,
+          &mDtbTableGuid))
+    {
+      DEBUG ((DEBUG_ERROR,
+        "[FvBootDxe] DTB config table found at %p\n",
+        gST->ConfigurationTable[Index].VendorTable));
+      Found = TRUE;
+      break;
+    }
+  }
+
+  if (!Found) {
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe] WARNING: DTB not in config table — "
+      "Barebox may fail to enumerate hardware\n"));
+  }
+}
+
+/**
+  Dump all configuration tables for diagnostics.
+**/
+STATIC
+VOID
+DumpConfigTables (
+  VOID
+  )
+{
+  UINTN   Index;
+  CHAR16  GuidStr[64];
+
+  DEBUG ((DEBUG_ERROR,
+    "[FvBootDxe] SystemTable has %d config table(s)\n",
+    gST->NumberOfTableEntries));
+
+  for (Index = 0; Index < gST->NumberOfTableEntries; Index++) {
+    UnicodeSPrint (
+      GuidStr, sizeof (GuidStr), L"%g",
+      &gST->ConfigurationTable[Index].VendorGuid
+      );
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe]   [%d] %s = %p\n",
+      Index,
+      GuidStr,
+      gST->ConfigurationTable[Index].VendorTable
+      ));
+  }
+}
+
+/**
+  Set BootOptionSupport UEFI variable.
+**/
+STATIC
+VOID
+SetBootOptionSupport (
+  VOID
+  )
+{
+  UINT32  BootOptionSupport;
+
+  BootOptionSupport = EFI_BOOT_OPTION_SUPPORT_APP |
+                      EFI_BOOT_OPTION_SUPPORT_SYSPREP;
+
+  gRT->SetVariable (
+         EFI_BOOT_OPTION_SUPPORT_VARIABLE_NAME,
+         &gEfiGlobalVariableGuid,
+         EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+         sizeof (BootOptionSupport),
+         &BootOptionSupport
+         );
+}
+
+// ── BDS Entry Point ───────────────────────────────────────────────────────────
+
+/**
+  BdsEntry — called by DXE Core after all drivers are dispatched.
+
+  Setup order:
+    1. BootOptionSupport variable
+    2. Connect all controllers (SerialDxe, VirtioBlk, PCI, GOP, FAT all bind)
+    3. Connect all consoles via EfiBootManagerConnectAllConsoles
+       (adds every SimpleTextOutput/Input to ConSplitter — same as BdsDxe fallback)
+    4. Verify DTB in config table
+    5. Dump config tables (debug)
+    6. Load and start the FV application
+
+  @param[in]  This    EFI_BDS_ARCH_PROTOCOL instance.
+**/
+VOID
+EFIAPI
+FvBootBdsEntry (
+  IN EFI_BDS_ARCH_PROTOCOL  *This
+  )
+{
+  EFI_STATUS                Status;
+  EFI_HANDLE                FvHandle;
+  EFI_DEVICE_PATH_PROTOCOL *DevicePath;
+  EFI_HANDLE                ImageHandle;
+  UINTN                     ExitDataSize;
+
+  // ── 1. BootOptionSupport ─────────────────────────────────────────────────
+  SetBootOptionSupport ();
+
+  // ── 2. Connect all controllers ───────────────────────────────────────────
+  //
+  // Single pass — SerialDxe, TerminalDxe, VirtioBlk, PartitionDxe, FAT,
+  // GraphicsConsoleDxe, PCI all bind here.  No disconnect needed.
+  //
+  DEBUG ((DEBUG_ERROR, "[FvBootDxe] Connecting all controllers\n"));
+  ConnectAllControllers ();
+
+  // ── 3. Wire all consoles into the ConSplitter ────────────────────────────
+  //
+  // Enumerate every SimpleTextIn/Out handle, add device paths to ConIn/ConOut/
+  // ErrOut NVRAM variables, then call EfiBootManagerConnectAllDefaultConsoles()
+  // so ConPlatformDxe adds each one to the ConSplitter (gST->ConOut/ConIn).
+  // No disconnect — VirtioBlk partitions and FAT remain intact.
+  //
+  DEBUG ((DEBUG_ERROR, "[FvBootDxe] Connecting all consoles\n"));
+  ConnectAllConsoles ();
+
+  // ── 4. Verify DTB is in the config table ─────────────────────────────────
+  VerifyDtbConfigTable ();
+
+  // ── 5. Dump all config tables ─────────────────────────────────────────────
+  DumpConfigTables ();
+
+  // ── 6. Load and start the FV application ─────────────────────────────────
+  FvHandle = NULL;
+  Status   = FindApplicationInFv (&FvHandle);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe] Application not found in FV: %r\n", Status));
+    goto Halt;
+  }
+
+  DevicePath = BuildFvApplicationDevicePath (FvHandle);
+  if (DevicePath == NULL) {
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe] Failed to build device path\n"));
+    goto Halt;
+  }
+
+  ImageHandle  = NULL;
+  ExitDataSize = 0;
+
+  Status = gBS->LoadImage (
+                  FALSE, gImageHandle,
+                  DevicePath, NULL, 0,
+                  &ImageHandle
+                  );
+  FreePool (DevicePath);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR,
+      "[FvBootDxe] LoadImage failed: %r\n", Status));
+    goto Halt;
+  }
+
+  DEBUG ((DEBUG_ERROR,
+    "[FvBootDxe] Transferring control to FV application\n"));
+
+  Status = gBS->StartImage (ImageHandle, &ExitDataSize, NULL);
+
+  DEBUG ((DEBUG_ERROR,
+    "[FvBootDxe] Application returned unexpectedly: %r\n", Status));
+
+Halt:
+  DEBUG ((DEBUG_ERROR, "[FvBootDxe] Halting (CpuDeadLoop)\n"));
+  CpuDeadLoop ();
+}
+
+// ── Module Entry Point ────────────────────────────────────────────────────────
+
+EFI_STATUS
+EFIAPI
+FvBootDxeEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+
+  ASSERT (!IsZeroGuid ((EFI_GUID *)PcdGetPtr (PcdFvBootApplicationGuid)));
+
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &ImageHandle,
+                  &gEfiBdsArchProtocolGuid, &mBds,
+                  NULL
+                  );
+  ASSERT_EFI_ERROR (Status);
+
+  DEBUG ((DEBUG_INFO,
+    "[FvBootDxe] Installed BDS — will boot FV application %g\n",
+    (EFI_GUID *)PcdGetPtr (PcdFvBootApplicationGuid)));
+
+  return Status;
+}
